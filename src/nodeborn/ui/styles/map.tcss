#map-layout {
    layout: vertical;
    height: 1fr;
    align: center middle;
    padding: 1 2;
}

#map-view {
    width: 128;
    height: 24;
    max-width: 100%;
    border: round $primary;
    padding: 0 1;
    background: $surface;
}

#map-status {
    width: 128;
    max-width: 100%;
    height: 3;
    border: round $accent;
    padding: 0 1;
    margin-top: 1;
}

MapView > .mapview--grass {
    color: $terrain-grass;
}

MapView > .mapview--plains {
    color: $terrain-plains;
}

MapView > .mapview--water {
    color: $terrain-water;
}

MapView > .mapview--mountain {
    color: $terrain-mountain;
}

MapView > .mapview--forest {
    color: $terrain-forest;
}

MapView > .mapview--sand {
    color: $terrain-sand;
}

MapView > .mapview--rock {
    color: $terrain-rock;
}

MapView > .mapview--river {
    color: $terrain-river;
}

MapView > .mapview--cursor-strong {
    background: $accent 35%;
    color: $text;
}

MapView > .mapview--cursor-soft {
    background: $primary 20%;
    color: $text;
}

MapView > .mapview--building {
    color: $warning;
    text-style: bold;
}

MapView > .mapview--ghost-valid {
    background: $success 40%;
    color: $text;
}

MapView > .mapview--ghost-invalid {
    background: $error 40%;
    color: $text;
}

#build-palette {
    dock: right;
    margin: 1 2;
    layer: overlay;
}