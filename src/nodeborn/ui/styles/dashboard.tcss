#dashboard-grid {
    layout: grid;
    grid-size: 2;
    grid-columns: 1fr 2fr;
    grid-rows: 1fr 1fr;
    grid-gutter: 1 2;
    padding: 1 2;
    height: 1fr;
}

#panel-population {
    row-span: 1;
    column-span: 1;
}

#panel-resources {
    row-span: 1;
    column-span: 1;
}

#panel-alerts {
    row-span: 1;
    column-span: 1;
}

#panel-event-log {
    row-span: 1;
    column-span: 1;
}

.dashboard-panel {
    background: $surface;
    color: #94a3b8;
    border: round #334155;
    padding: 1 2;
}

#panel-population {
    border: round $primary;
    color: $foreground;
}

#panel-resources {
    border: round $success;
    color: $foreground;
}

#panel-alerts {
    border: round $warning;
    color: $warning;
}

#panel-event-log {
    border: round #6b7280;
    color: $foreground;
}
